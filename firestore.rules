rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ──

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/config/superadmins)
        && request.auth.uid in get(/databases/$(database)/documents/config/superadmins).data.admins;
    }

    function isTenantMember(tenantId) {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid));
    }

    function getTenantRole(tenantId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)).data.role;
    }

    function isTenantOwner(tenantId) {
      return isTenantMember(tenantId) && getTenantRole(tenantId) == 'owner';
    }

    function isTenantManager(tenantId) {
      return isTenantMember(tenantId) && getTenantRole(tenantId) in ['owner', 'manager'];
    }

    // ── Global Config ──
    match /config/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // ── Global Users Collection ──
    match /users/{userId} {
      // Users can read their own profile; superadmins can read all
      allow read: if isOwner(userId) || isSuperAdmin();
      // Users can only be created during registration (auth trigger)
      allow create: if isOwner(userId);
      // Users can update their own non-sensitive fields
      allow update: if isOwner(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.tenantId == resource.data.tenantId;
      allow delete: if false; // Never delete user docs directly
    }

    // ── Tenants ──
    match /tenants/{tenantId} {
      // Tenant info readable by members and superadmins
      allow read: if isTenantMember(tenantId) || isSuperAdmin();
      // Only the authenticated user creating their own tenant (registration)
      allow create: if isAuthenticated() && request.auth.uid == tenantId;
      // Only tenant owner or superadmin can update tenant info
      allow update: if isTenantOwner(tenantId) || isSuperAdmin();
      allow delete: if isSuperAdmin(); // Only superadmin can delete tenants

      // ── Tenant Members ──
      match /members/{memberId} {
        allow read: if isTenantMember(tenantId) || isSuperAdmin();
        // Owner creating the first member (themselves) during registration
        allow create: if (isOwner(memberId) && request.auth.uid == tenantId)
          || isTenantOwner(tenantId)
          || isSuperAdmin();
        // Only tenant owner or superadmin can update members
        allow update: if isTenantOwner(tenantId) || isSuperAdmin();
        allow delete: if isTenantOwner(tenantId) || isSuperAdmin();
      }

      // ── All tenant-scoped business data ──
      // Sites, Workers, Contacts, Quotes, Contracts, Invoices, Orders,
      // Purchases, Stocks, Equipment, Tasks, Timesheets, Files, Companies

      match /sites/{docId} {
        allow read: if isTenantMember(tenantId) || isSuperAdmin();
        allow create: if isTenantManager(tenantId) || isSuperAdmin();
        allow update: if isTenantManager(tenantId) || isSuperAdmin();
        allow delete: if isTenantManager(tenantId) || isSuperAdmin();

        // ── Subcollections under site ──
        match /timeLogs/{logId} {
          allow read: if isTenantMember(tenantId) || isSuperAdmin();
          allow create: if isTenantMember(tenantId) || isSuperAdmin();
          allow update: if isTenantManager(tenantId) || isSuperAdmin();
          allow delete: if isTenantManager(tenantId) || isSuperAdmin();
        }

        match /materials/{matId} {
          allow read: if isTenantMember(tenantId) || isSuperAdmin();
          allow create: if isTenantMember(tenantId) || isSuperAdmin();
          allow update: if isTenantManager(tenantId) || isSuperAdmin();
          allow delete: if isTenantManager(tenantId) || isSuperAdmin();
        }

        match /tools/{toolId} {
          allow read: if isTenantMember(tenantId) || isSuperAdmin();
          allow create: if isTenantMember(tenantId) || isSuperAdmin();
          allow update: if isTenantManager(tenantId) || isSuperAdmin();
          allow delete: if isTenantManager(tenantId) || isSuperAdmin();
        }
      }

      match /workers/{docId} {
        allow read: if isTenantMember(tenantId) || isSuperAdmin();
        allow create: if isTenantManager(tenantId) || isSuperAdmin();
        allow update: if isTenantManager(tenantId) || isSuperAdmin();
        allow delete: if isTenantManager(tenantId) || isSuperAdmin();
      }

      match /contacts/{docId} {
        allow read: if isTenantMember(tenantId) || isSuperAdmin();
        allow create: if isTenantManager(tenantId) || isSuperAdmin();
        allow update: if isTenantManager(tenantId) || isSuperAdmin();
        allow delete: if isTenantManager(tenantId) || isSuperAdmin();
      }

      match /quotes/{docId} {
        allow read: if isTenantManager(tenantId) || isSuperAdmin();
        allow create: if isTenantManager(tenantId) || isSuperAdmin();
        allow update: if isTenantManager(tenantId) || isSuperAdmin();
        allow delete: if isTenantOwner(tenantId) || isSuperAdmin();
      }

      match /contracts/{docId} {
        allow read: if isTenantManager(tenantId) || isSuperAdmin();
        allow create: if isTenantManager(tenantId) || isSuperAdmin();
        allow update: if isTenantManager(tenantId) || isSuperAdmin();
        allow delete: if isTenantOwner(tenantId) || isSuperAdmin();
      }

      match /invoices/{docId} {
        allow read: if isTenantManager(tenantId) || isSuperAdmin();
        allow create: if isTenantManager(tenantId) || isSuperAdmin();
        allow update: if isTenantManager(tenantId) || isSuperAdmin();
        allow delete: if isTenantOwner(tenantId) || isSuperAdmin();
      }

      match /orders/{docId} {
        allow read: if isTenantManager(tenantId) || isSuperAdmin();
        allow create: if isTenantManager(tenantId) || isSuperAdmin();
        allow update: if isTenantManager(tenantId) || isSuperAdmin();
        allow delete: if isTenantOwner(tenantId) || isSuperAdmin();
      }

      match /purchases/{docId} {
        allow read: if isTenantManager(tenantId) || isSuperAdmin();
        allow create: if isTenantManager(tenantId) || isSuperAdmin();
        allow update: if isTenantManager(tenantId) || isSuperAdmin();
        allow delete: if isTenantOwner(tenantId) || isSuperAdmin();
      }

      match /stocks/{docId} {
        allow read: if isTenantMember(tenantId) || isSuperAdmin();
        allow create: if isTenantManager(tenantId) || isSuperAdmin();
        allow update: if isTenantManager(tenantId) || isSuperAdmin();
        allow delete: if isTenantManager(tenantId) || isSuperAdmin();
      }

      match /equipment/{docId} {
        allow read: if isTenantMember(tenantId) || isSuperAdmin();
        allow create: if isTenantManager(tenantId) || isSuperAdmin();
        allow update: if isTenantManager(tenantId) || isSuperAdmin();
        allow delete: if isTenantManager(tenantId) || isSuperAdmin();
      }

      match /tasks/{docId} {
        allow read: if isTenantMember(tenantId) || isSuperAdmin();

        // New tasks must start at the default hours-approval state — closes the
        // "create a task pre-approved" bypass. Does NOT validate workerId against
        // the caller's own authUid: a conscious, documented tradeoff for a small
        // trusted team, matching this app's existing rules posture elsewhere.
        allow create: if isSuperAdmin() || (
          isTenantMember(tenantId) &&
          request.resource.data.get('hoursStatus', 'estimated') == 'estimated'
        );

        // hoursStatus drives an approval workflow layered on top of the existing
        // free-form task fields (title/desc/kanban status/photos/changeOrders),
        // which any member can still edit. Access to hoursStatus itself is more
        // restricted:
        //  - untouched by the write: always fine (covers ordinary field edits)
        //  - member moves estimated <-> submitted: fine, but only pre-decision
        //  - manager decides submitted -> approved/rejected: precondition on the
        //    OLD value prevents a double-approve race (two managers / a double
        //    click both succeeding and creating two timesheets)
        //  - manager pulls an approved/rejected task back to submitted for
        //    re-review (does not auto-clean any timesheet already created —
        //    manual follow-up, same as any other manager-delete action here)
        // .get(field, default) (not direct field access) is required throughout:
        // every task predating this feature has no hoursStatus field at all, and
        // direct access on a missing key errors, which — left unguarded — would
        // silently strip plain members (not managers) of the ability to move a
        // kanban card or add a photo on any pre-existing task.
        allow update: if isSuperAdmin() || (
          isTenantMember(tenantId) &&
          (
            request.resource.data.get('hoursStatus','estimated') == resource.data.get('hoursStatus','estimated') ||
            (
              resource.data.get('hoursStatus','estimated') != 'approved' &&
              request.resource.data.get('hoursStatus','estimated') in ['estimated', 'submitted']
            ) ||
            (
              isTenantManager(tenantId) &&
              request.resource.data.hoursStatus in ['approved', 'rejected'] &&
              resource.data.get('hoursStatus','estimated') == 'submitted'
            ) ||
            (
              isTenantManager(tenantId) &&
              resource.data.get('hoursStatus','estimated') in ['approved', 'rejected'] &&
              request.resource.data.get('hoursStatus','estimated') == 'submitted'
            )
          )
        );

        allow delete: if isTenantManager(tenantId) || isSuperAdmin();
      }

      match /timesheets/{docId} {
        allow read: if isTenantMember(tenantId) || isSuperAdmin();
        // Manager-only create: closes the pre-existing gap where any plain worker
        // could self-log arbitrary timesheet hours with zero oversight. A plain
        // worker's only path to a timesheet is now the task approval pipeline
        // (the approving manager's own write satisfies this rule); direct manager
        // entry is unaffected.
        allow create: if isTenantManager(tenantId) || isSuperAdmin();
        allow update: if isTenantManager(tenantId) || isSuperAdmin();
        allow delete: if isTenantManager(tenantId) || isSuperAdmin();
      }

      match /files/{docId} {
        allow read: if isTenantMember(tenantId) || isSuperAdmin();
        allow create: if isTenantMember(tenantId) || isSuperAdmin();
        allow update: if isTenantManager(tenantId) || isSuperAdmin();
        allow delete: if isTenantManager(tenantId) || isSuperAdmin();
      }

      match /companies/{docId} {
        allow read: if isTenantMember(tenantId) || isSuperAdmin();
        allow create: if isTenantOwner(tenantId) || isSuperAdmin();
        allow update: if isTenantOwner(tenantId) || isSuperAdmin();
        allow delete: if isTenantOwner(tenantId) || isSuperAdmin();
      }

      match /notifications/{notifId} {
        // Only the recipient can read their own notifications
        allow read: if isAuthenticated() && resource.data.recipientUid == request.auth.uid;
        // Server (Admin SDK) creates; tenant members may create client-side if needed
        allow create: if isTenantMember(tenantId);
        // Only recipient can mark as read / update
        allow update: if isAuthenticated() && resource.data.recipientUid == request.auth.uid;
        // Recipient can delete their own
        allow delete: if isAuthenticated() && resource.data.recipientUid == request.auth.uid;
      }
    }

    // ── Cross-tenant collaborations (top-level, not tenant-nested) ──
    match /collaborations/{collabId} {
      // Either party may read their own collaborations
      allow read: if isAuthenticated() && (
        isTenantMember(resource.data.ownerTenantId) ||
        isTenantMember(resource.data.contractorTenantId)
      );
      // All writes go through server-side API routes (Admin SDK)
      allow create, update, delete: if false;
    }
  }
}
